# Copy to .env.local for local development. Never commit real values.

# GitHub fine-grained personal access token (read-only, public repositories).
# SECRET — server-only. Never prefix with NEXT_PUBLIC_.
# Optional: without it the site renders from src/data/github-snapshot.json.
GITHUB_TOKEN=

# GitHub login whose profile, contributions and repositories are shown.
GITHUB_USERNAME=uyenne06

# Public base URL of the deployed site (canonical URLs, sitemap, Open Graph).
# Not a secret. Falls back to the Vercel production domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
